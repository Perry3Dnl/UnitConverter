<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>RealisticPhysics.UnitConversion</AssemblyName>
    <RootNamespace>RealisticPhysics.UnitConversion</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>RealisticPhysics.UnitConversion</PackageId>
    <Authors>Perry3Dnl</Authors>
    <Description>Standalone unit conversion library with 97 conversion families, static converters, direct methods, numeric extensions, and unit metadata.</Description>
    <PackageTags>units;conversion;physics;engineering</PackageTags>
    <PackageProjectUrl>https://github.com/Perry3Dnl/UnitConverter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Perry3Dnl/UnitConverter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Standalone .NET migration of the 1.1.3 conversion core. Unity editor integration and assets have been removed; converter APIs and arithmetic are preserved.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
