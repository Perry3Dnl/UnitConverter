<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <AssemblyName>UnitConverter</AssemblyName>
    <RootNamespace>UnitConverter</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>UnitConverter</PackageId>
    <Title>UnitConverter</Title>
    <Authors>Perry3Dnl</Authors>
    <Description>High-performance .NET unit conversion library with 150 physical and engineering families, strongly typed quantities, exact decimal/rational conversion, span parsing and formatting, composite and custom units, runtime metadata, culture-aware localized unit vocabulary, and arbitrary-scale number conversion.</Description>
    <PackageTags>units;conversion;physics;engineering;quantities;dimensional-analysis;decimal;parsing;formatting;big-numbers;arbitrary-scale</PackageTags>
    <PackageProjectUrl>https://github.com/Perry3Dnl/UnitConverter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Perry3Dnl/UnitConverter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <Copyright>Copyright © 2026 Perry3Dnl</Copyright>
    <PackageReleaseNotes>2.0.0-preview.2: 150 conversion families and 1,858 unit entries; catalog-wide strongly typed quantities and dimensional arithmetic; exact decimal/rational conversion; allocation-free span parsing/formatting for typed quantities; optimized dynamic detection and composite expressions; runtime custom units; integrated arbitrary-scale number conversion; System.Text.Json companion support; NativeAOT validation; definition-driven culture-aware unit display/parse localization; culture-consistent typed/span parsing and named quantity formatting; completed inverse dimensional arithmetic; culture-symmetric dynamic detection; immutable/indexed runtime metadata; hardened exact and arbitrary-scale input contracts; XML IntelliSense docs; symmetric catalog lookups; tightened public result/TryConvert contracts; public API compatibility baseline; catalog-wide mathematical conformance and parser abuse testing; expanded measurable Dutch localization; multi-target clean-consumer validation; optional analyzer guidance package; Apache-2.0 with Commons Clause v1.0 licensing.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE.md" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>