<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>UnitConverter</AssemblyName>
    <RootNamespace>UnitConverter</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>UnitConverter</PackageId>
    <Authors>Perry3Dnl</Authors>
    <Description>Dependency-free .NET conversion library with 98 physical unit families, parsing, composite and custom units, metadata, and arbitrary-scale number conversion.</Description>
    <PackageTags>units;conversion;physics;engineering;numbers;big-numbers;arbitrary-scale</PackageTags>
    <PackageProjectUrl>https://github.com/Perry3Dnl/UnitConverter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Perry3Dnl/UnitConverter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Standalone .NET migration of the 1.1.3 conversion core. Unity editor integration and assets have been removed; converter APIs and arithmetic are preserved.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
