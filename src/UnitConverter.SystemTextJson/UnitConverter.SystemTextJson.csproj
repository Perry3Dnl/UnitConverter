<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>UnitConverter.SystemTextJson</AssemblyName>
    <RootNamespace>UnitConverter.SystemTextJson</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>UnitConverter.SystemTextJson</PackageId>
    <Authors>Perry3Dnl</Authors>
    <Description>System.Text.Json serialization support for UnitConverter typed unit values.</Description>
    <PackageTags>units;conversion;json;serialization;system.text.json</PackageTags>
    <PackageProjectUrl>https://github.com/Perry3Dnl/UnitConverter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Perry3Dnl/UnitConverter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UnitConverter/UnitConverter.csproj" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
