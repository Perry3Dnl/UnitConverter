<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <AssemblyName>UnitTools</AssemblyName>
    <RootNamespace>UnitTools</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>UnitTools</PackageId>
    <PackageIcon>unittools.png</PackageIcon>
    <Title>UnitTools</Title>
    <Authors>Perry3Dnl</Authors>
    <Description>Dependency-free high-performance .NET unit conversion library with 150 physical and engineering families, direct numeric APIs, strongly typed quantities, exact decimal/rational conversion, span parsing/formatting, dynamic and composite conversion, custom units, metadata, localization, and arbitrary-scale numbers.</Description>
    <PackageTags>units;unit-converter;conversion;measurement;units-of-measurement;physics;engineering;quantities;dimensional-analysis;decimal;parsing;formatting;high-performance;nativeaot;big-numbers;arbitrary-scale</PackageTags>
    <PackageProjectUrl>https://github.com/Perry3Dnl/UnitTools</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Perry3Dnl/UnitTools</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.NUGET.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <Copyright>Copyright © 2026 Perry3Dnl</Copyright>
    <PackageReleaseNotes>1.0.1: 150 conversion families and 1,858 unit entries; catalog-wide strongly typed quantities and dimensional arithmetic; exact decimal/rational conversion; allocation-free span parsing/formatting for typed quantities; optimized dynamic detection and composite expressions; runtime custom units; integrated arbitrary-scale number conversion; System.Text.Json companion support; NativeAOT validation; definition-driven culture-aware unit display/parse localization; culture-consistent typed/span parsing and named quantity formatting; completed inverse dimensional arithmetic; culture-symmetric dynamic detection; immutable/indexed runtime metadata; hardened exact and arbitrary-scale input contracts; XML IntelliSense docs; symmetric catalog lookups; tightened public result/TryConvert contracts; public API compatibility gate; catalog-wide mathematical conformance and parser abuse guards; expanded Dutch localization coverage; multi-TFM clean consumer verification; optional analyzer guidance package; Apache-2.0 with Commons Clause v1.0 licensing.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.NUGET.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE.md" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE" Pack="true" PackagePath="/" />
    <None Include="../../assets/unittools.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>